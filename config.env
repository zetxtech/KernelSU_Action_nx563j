# Kernel source (official LineageOS tree, lineage-22.2 = Android 15 nightly line)
KERNEL_SOURCE=https://github.com/LineageOS/android_kernel_nubia_msm8998.git
KERNEL_SOURCE_BRANCH=lineage-22.2
KERNEL_DEFCONFIG=lineageos_nx563j_defconfig
TARGET_ARCH=arm64
KERNEL_FILE=Image.gz-dtb
CLANG_VERSION=r487747c
EXTRA_BUILD_COMMAND:LD=ld.lld LLVM=1 LLVM_IAS=1
USE_KERNELSU=true
MAKE_BOOT_IMAGE=true
BOOT_SIGNATURE=true
# Stock boot image from the latest official LOS 22.2 nightly.
# Nightlies build every Friday: bump the date in this URL after each build.
SOURCE_BOOT_IMAGE=https://mirrorbits.lineageos.org/full/nx563j/20260911/boot.img